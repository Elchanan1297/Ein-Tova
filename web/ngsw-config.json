{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/assets/logo/ein-tova-eye-dark.svg"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)",
          "/**/*.(mp3|m4a|aac|ogg|wav)"
        ]
      }
    },
    {
      "name": "fonts",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "urls": ["https://fonts.googleapis.com/**", "https://fonts.gstatic.com/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "content",
      "urls": ["/api/program", "/api/greetings"],
      "cacheConfig": { "strategy": "freshness", "timeout": "4s", "maxAge": "7d", "maxSize": 20 }
    },
    {
      "name": "leaderboard",
      "urls": ["/api/leaderboard"],
      "cacheConfig": { "strategy": "freshness", "timeout": "4s", "maxAge": "1d", "maxSize": 1 }
    },
    {
      "name": "media",
      "urls": ["/media/**", "https://i.ytimg.com/**"],
      "cacheConfig": { "strategy": "performance", "maxAge": "30d", "maxSize": 200 }
    }
  ]
}
